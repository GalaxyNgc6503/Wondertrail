# Copy this file to `.env` and fill in your real values.
# Never commit the real .env — add it to .gitignore.

APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a9669dc001f389b1067
APPWRITE_DATABASE_ID=6aa124a8002a6946d701
APPWRITE_TRAILS_COLLECTION_ID=trails
APPWRITE_STOPS_COLLECTION_ID=stops
APPWRITE_PHOTOS_BUCKET_ID=stop-photos
APPWRITE_DESTINATIONS_COLLECTION_ID=destinations

# RevenueCat — leave blank to run the app as free tier (no purchases possible).
# Create an entitlement (default id "premium") in the RevenueCat dashboard and
# attach your store products to it.

# Test Store key (Project Settings > API keys > Test Store, prefixed "test_").
# Set this during development — it's checked first, works on iOS + Android
# with no sandbox Apple/Google accounts, and shows a local purchase dialog.
# NEVER ship a release build with this set.
REVENUECAT_API_KEY_TEST=test_yApoHdEZrmBbtVbyCpCMAvNBFtC

REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
REVENUECAT_ENTITLEMENT_ID=premium
# Debug-only: set to "true" to force premium locally without any store at all.
REVENUECAT_DEBUG_PREMIUM=false
